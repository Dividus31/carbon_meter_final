# Copy this file to .env and fill in real values. Never commit .env.

# Port the API server listens on
PORT=3000

# development | production
NODE_ENV=development

# Postgres connection string
# Local install:            postgresql://carbonmeter:carbonmeter@localhost:5432/carbonmeter
# Throwaway docker instance: postgresql://carbonmeter:carbonmeter@localhost:5432/carbonmeter
DATABASE_URL=postgresql://carbonmeter:carbonmeter@localhost:5432/carbonmeter

# Secret used to sign login session JWTs - use a long random string in production
# e.g. generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Origin the static frontend is served from, used for CORS with credentials.
# In development (NODE_ENV=development) any http://localhost:<port> or
# http://127.0.0.1:<port> origin is allowed automatically, so this value
# only matters in production.
CLIENT_ORIGIN=http://localhost:8080

# Set to true once the API is served over HTTPS in production so the login
# cookie is only ever sent over an encrypted connection
COOKIE_SECURE=false
